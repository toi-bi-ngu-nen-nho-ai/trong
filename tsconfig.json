{
  // Bản đồ `paths` nằm trong file được SINH RA `tsconfig.vendor-paths.json` (xem
  // scripts/tao-paths-vendor.mjs, chạy trong `npm run dung:vendor`): 437 subpath của cây
  // vendored, trỏ vào .d.ts trong .vendor-build/ — quá nhiều để chép tay và sẽ lệch mỗi lần
  // nâng cấp cây vendored.
  //
  // KHÔNG khai `paths` trong file này: `extends` GHI ĐÈ trọn khoá `paths` chứ không trộn, nên
  // khai ở đây là xoá sạch bản đồ kia. Cả `@/*` cũng phải nằm trong file sinh ra vì lý do đó.
  "extends": "./tsconfig.vendor-paths.json",
  "compilerOptions": {
    // ES2022 vì mã vendored (src/vendor/blocksuite) dùng `new Error(msg, { cause })` và
    // `String.replaceAll`. D11 cấm sửa mã vendored, nên chỗ phải nhượng là cấu hình của ta.
    "target": "ES2022",
    // false để khớp BlockSuite (AFFiNE/tsconfig.json). Mã vendored dùng tham số constructor
    // ngay trong khởi tạo field — hợp lệ khi field được gán trong constructor (false), nhưng
    // là TS2729 khi field dùng ngữ nghĩa `define` (true). Lớp duy nhất của ta là ErrorBoundary,
    // hành xử y hệt dưới cả hai.
    //
    // Ta KHÔNG theo target ES2024 của AFFiNE: đây là PWA chạy trên iPhone đời cũ, ES2022 là
    // mức Safari 16.4 trở lên, đủ cho mã vendored mà không đẩy trần thiết bị lên cao hơn cần.
    "useDefineForClassFields": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts"],
  // Tệp dưới đây chỉ khai báo kiểu global (ambient) mà không nơi nào import — TypeScript chỉ
  // đưa các tệp ambient vào chương trình khi chúng nằm trong tập gốc (root set). Một khi
  // src/vendor/blocksuite bị exclude, tệp này rớt khỏi tập gốc và các kiểu global của nó
  // (VirtualKeyboard, VirtualKeyboardEventMap) biến mất dù disposable/index.ts vẫn được kéo vào
  // gián tiếp qua alias @blocksuite/global/disposable. Đặt tên tệp trong "include" KHÔNG đủ:
  // "exclude" vẫn lọc các đường dẫn cụ thể khớp với mẫu thư mục bị loại (đã kiểm chứng bằng
  // `tsc --listFilesOnly`, tệp không xuất hiện dù được include tường minh). Chỉ "files" mới
  // không bị "exclude" lọc, nên phải nêu đích danh tệp này ở đây.
  "files": ["src/vendor/blocksuite/framework/global/src/types/virtual-keyboard.ts"],
  // src/vendor/blocksuite là mã bên thứ ba (2634 tệp .ts), được biên dịch (transcompile) chứ
  // không kiểm kiểu bởi cổng này — cổng kiểm kiểu type-check riêng cho cây vendored đã tắt
  // strict/noEmitOnError với lý do tương tự. Loại khỏi tập tệp gốc để 2634 tệp đó không lấn át
  // cổng kiểm kiểu của mã dự án; các tệp vendored vẫn có thể được kéo vào gián tiếp qua import
  // (paths @blocksuite/*) từ src/core, và lỗi ở đó (nếu có) vẫn được báo cáo, không bị ẩn.
  "exclude": ["src/vendor/blocksuite"]
}
